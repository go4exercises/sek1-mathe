% Gitter für Gesamttest und Bewertungspaket «Funktionstypen und Graphen» (\usepackage{ft-gitter} nach lp-druck), aus lf-gitter.sty.
% \gitter{xmin}{xmax}{ymin}{ymax}{Inhalt}: Karo 6 mm, Achsen mit Pfeil, jede ganze Zahl beschriftet.
\newcommand{\gitter}[5]{\begin{tikzpicture}[x=6mm,y=6mm,font=\scriptsize]
  \draw[lplinie,line width=0.3pt,step=1] (#1,#3) grid (#2,#4);
  \draw[->,line width=0.6pt] (#1,0) -- (#2+0.5,0) node[right] {$x$};
  \draw[->,line width=0.6pt] (0,#3) -- (0,#4+0.5) node[above] {$y$};
  \foreach \i in {#1,...,#2} {\ifnum\i=0\else\node[below,inner sep=1.5pt] at (\i,0) {$\i$};\fi}
  \foreach \j in {#3,...,#4} {\ifnum\j=0\else\node[left,inner sep=3pt] at (0,\j) {$\j$};\fi}
  \node[below left,inner sep=1.5pt] at (0,0) {$0$};
  #5
\end{tikzpicture}}
% \sachgitter{Zellen x}{Zellen y}{Schritt t}{Schritt V}{Inhalt}: Achsen t [min] und V [ml], Zelle 8 mm, Inhalt in Zellen.
\newcommand{\sachgitter}[5]{\begin{tikzpicture}[x=8mm,y=8mm,font=\scriptsize]
  \draw[lplinie,line width=0.3pt,step=1] (0,0) grid (#1,#2);
  \draw[->,line width=0.6pt] (0,0) -- (#1+0.6,0) node[right] {$t$ [min]};
  \draw[->,line width=0.6pt] (0,0) -- (0,#2+0.6) node[above] {$V$ [ml]};
  \foreach \i in {0,...,#1} {\pgfmathtruncatemacro{\w}{\i*#3}\node[below,inner sep=1.5pt] at (\i,0) {$\w$};}
  \foreach \j in {1,...,#2} {\pgfmathtruncatemacro{\w}{\j*#4}\node[left,inner sep=3pt] at (0,\j) {$\w$};}
  #5
\end{tikzpicture}}
% \kleingraph{Buchstabe}{Inhalt}: kleines Koordinatensystem x −2 … 5, y −3 … 9 (Karo 3.5 mm) für die Zuordnung in G1.
\newcommand{\kleingraph}[2]{\begin{tikzpicture}[x=3.5mm,y=3.5mm,font=\tiny]
  \draw[lplinie,line width=0.25pt,step=1] (-2,-3) grid (5,9);
  \draw[->,line width=0.5pt] (-2,0) -- (5.5,0) node[right] {$x$};
  \draw[->,line width=0.5pt] (0,-3) -- (0,9.5) node[above] {$y$};
  \foreach \i in {-1,1,2,3,4} \node[below,inner sep=1pt] at (\i,0) {$\i$};
  \foreach \j in {-2,2,4,6,8} \node[left,inner sep=1.5pt] at (0,\j) {$\j$};
  \begin{scope} \clip (-2,-3) rectangle (5,9); #2 \end{scope}
  \node[font=\small\bfseries,fill=white,inner sep=1pt] at (-1.2,8.2) {#1};
\end{tikzpicture}}
% \wegzeit{Zellen t}{Zellen s}{Schritt t}{Schritt s}{Name y}{Inhalt}: Weg-Zeit-Achsen t [min], Zelle 6 mm.
\newcommand{\wegzeit}[6]{\begin{tikzpicture}[x=6mm,y=6mm,font=\scriptsize]
  \draw[lplinie,line width=0.3pt,step=1] (0,0) grid (#1,#2);
  \draw[->,line width=0.6pt] (0,0) -- (#1+0.6,0) node[right] {$t$ [min]};
  \draw[->,line width=0.6pt] (0,0) -- (0,#2+0.6) node[above] {#5};
  \foreach \i in {0,...,#1} {\pgfmathtruncatemacro{\w}{\i*#3}\node[below,inner sep=1.5pt] at (\i,0) {$\w$};}
  \foreach \j in {1,...,#2} {\pgfmathtruncatemacro{\w}{\j*#4}\node[left,inner sep=3pt] at (0,\j) {$\w$};}
  #6
\end{tikzpicture}}
% \skizze{Buchstabe}{Punkte}: kleine Weg-Zeit-Skizze ohne Zahlen (G6).
\newcommand{\skizze}[2]{\begin{tikzpicture}[x=5mm,y=5mm,font=\scriptsize]
  \draw[->,line width=0.5pt] (0,0) -- (7,0) node[right] {$t$};
  \draw[->,line width=0.5pt] (0,0) -- (0,4.5) node[above] {Entfernung};
  \draw[lpblau,line width=1.1pt] #2;
  \node[font=\small\bfseries] at (6.4,4) {#1};
\end{tikzpicture}}
