% lp-druck.sty — gemeinsame Gestaltung der Leitprogramm-PDFs (Gesamttest, Bewertungspaket).
% Übersetzt mit pdfLaTeX (Palatino über mathpazo, T1): python3 scripts/build-lp-pdf.py
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lp-druck}[2026/10/09 Leitprogramm-PDFs, Sek1-Mathe begreifbar]
\RequirePackage[T1]{fontenc}
\RequirePackage[ngerman]{babel}
\RequirePackage{amsmath,amssymb}
\RequirePackage[sc]{mathpazo}
\RequirePackage[a4paper,margin=17mm,top=16mm,bottom=18mm]{geometry}
\RequirePackage{xcolor,tikz,pgfplots,tabularx,array,booktabs,enumitem,fancyhdr,microtype,needspace}
\RequirePackage[most]{tcolorbox}
\pgfplotsset{compat=1.18}
\definecolor{lpblau}{HTML}{1A4F8A}
\definecolor{lporange}{HTML}{B85C00}
\definecolor{lpgruen}{HTML}{1F6B3A}
\definecolor{lprot}{HTML}{9B1C1C}
\definecolor{lplinie}{HTML}{D9D2C3}
\definecolor{lpgrau}{HTML}{6B6457}
% Name und RLP-Nummer des Leitprogramms. Jede Quelle setzt beide mit \renewcommand,
% bevor \lpkopf kommt — so taugt die Datei fuer alle Leitprogramme (seit 03.10.2026).
\newcommand{\lpname}{}
\newcommand{\lpteilgebiet}{}
% Bereich: in Sek1-Mathe immer «Sek I» (aus TALS Mathe übernommen, 09.10.2026).
\newcommand{\lpbereich}{Sek I}
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\footnotesize\color{lpgrau}Sek1-Mathe begreifbar · Leitprogramm \lpname}
\fancyfoot[R]{\footnotesize\color{lpgrau}\lpfuss\ · Seite \thepage}
\newcommand{\lpfuss}{}
% Kopf
\newcommand{\lpkopf}[2]{%
  {\footnotesize\color{lpgrau}\MakeUppercase{Sek1-Mathe begreifbar · Leitprogramm · \lpbereich\ \lpteilgebiet\ \lpname}}\par
  \vspace{2pt}{\LARGE\bfseries #1}\par\vspace{3pt}\textcolor{black}{\rule{\linewidth}{1.2pt}}\par\vspace{2pt}#2}
% Kästen
\newtcolorbox{lpinfo}[1]{colback=lpblau!7,colframe=lpblau!60,boxrule=0.5pt,leftrule=3pt,arc=1mm,
  title={\small\bfseries\MakeUppercase{#1}},coltitle=lpblau,colbacktitle=lpblau!7,attach title to upper=\par,fonttitle=\small}
\newtcolorbox{lpachtung}[1]{colback=lprot!6,colframe=lprot!60,boxrule=0.5pt,leftrule=3pt,arc=1mm,
  title={\small\bfseries\MakeUppercase{#1}},coltitle=lprot,colbacktitle=lprot!6,attach title to upper=\par}
\newtcolorbox{lpaufgabe}[3]{colback=white,colframe=lplinie,boxrule=0.6pt,arc=1mm,breakable=false,
  before upper={{\color{lporange}\bfseries #1}\hspace{4mm}{\bfseries #2}\hfill{\small\ttfamily\color{lpgrau}#3}\par\smallskip}}
\newcommand{\lpteil}[2]{\par\needspace{6\baselineskip}\medskip{\large\bfseries #1}\ {\color{lpgrau}— #2}\par\vspace{-2pt}\rule{\linewidth}{0.4pt}\par}
% Schreibfläche mit Linien
% K3 (03.10.2026): ohne den Abstand schneidet die gestrichelte Oberkante die
% Unterlaengen der letzten Textzeile.
\newcommand{\lpplatz}[1]{\par\vspace{4pt}\begin{tikzpicture}
  \foreach \i in {1,...,#1} \draw[lplinie,line width=0.4pt] (0,-\i*7mm) -- (\linewidth,-\i*7mm);
  \draw[lplinie,dashed,line width=0.4pt] (0,0) rectangle (\linewidth,-#1*7mm-2mm);
  \end{tikzpicture}\par}
